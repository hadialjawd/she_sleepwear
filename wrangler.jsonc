{
  // Cloudflare settings. Everything here is on the free plan.
  "name": "dashboard",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "vars": {
    // Google sign-in. The Client ID is public (it is not a secret).
    "GOOGLE_CLIENT_ID": "948130422997-ho39so9e3f9gmpqd6cffu29kn4sbojl1.apps.googleusercontent.com",
    // This Google account is the owner and is always allowed in.
    "OWNER_EMAIL": "hadialjawad718@gmail.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/icon-192.png", "/icon-512.png"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "she-sleepwear",
      // Created with: npx wrangler d1 create she-sleepwear --location eeur
      "database_id": "fc5c247c-075d-4816-a4e5-524d5c13e96b"
    }
  ]
}
