{
  // Cloudflare settings. Everything here is on the free plan.
  "name": "she-sleepwear",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/icon-192.png", "/icon-512.png"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "she-sleepwear",
      // Created with: npx wrangler d1 create she-sleepwear --location eeur
      "database_id": "fc5c247c-075d-4816-a4e5-524d5c13e96b"
    }
  ]
}
